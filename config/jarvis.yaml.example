# Jarvis core configuration.
# Copy this to jarvis.yaml and edit.

llm:
  # OpenAI-compatible API endpoint (LM Studio, Ollama, etc.)
  base_url: ${JARVIS_LLM_BASE_URL}
  api_key: ${JARVIS_LLM_API_KEY}
  model: ${JARVIS_LLM_MODEL}
  # Covers a whole non-streamed turn, not just time-to-first-token: reasoning
  # models on a local endpoint routinely need minutes for one tool-call turn,
  # plus a cold model load on the first request of the day. The outer bound on
  # a run is idle_timeout_sec below.
  request_timeout_sec: 600.0

timezone: ${JARVIS_TIMEZONE}
# Home location surfaced to agent runs so briefs can pull a local weather
# forecast (weather MCP server geocodes it). Omit to skip weather context.
# home_location: "Austin, Texas"
idle_timeout_sec: 900
max_concurrent_agents: 3
log_level: INFO
default_schedule_output_mode: discord
# ⚠ Peers uvicorn trusts to set X-Forwarded-For: the reverse proxy's IP ONLY,
# NEVER "*" (config validation rejects it). If uvicorn trusts X-Forwarded-For
# from arbitrary sources, anyone can spoof their client IP and walk straight
# past per-IP login rate limiting, failure backoff, and the audit trail's IP
# column. Leave unset when no proxy is in front (uvicorn then trusts
# loopback only).
# forwarded_allow_ips: "172.18.0.2"

# Host-header allow-list: the public domain(s) the dashboard is served on.
# Requests with any other Host get 400. localhost/127.0.0.1 are always
# allowed on top (the in-container Docker healthcheck uses them). Leave
# unset for local dev.
# trusted_hosts: ["jarvis.example.com"]

# Inbound event webhook (POST /events/webhook). Without a token the endpoint
# is disabled (404). Uncomment and set JARVIS_EVENTS_WEBHOOK_TOKEN to enable;
# senders must supply it as `Authorization: Bearer <token>`.
events:
  # webhook_token: ${JARVIS_EVENTS_WEBHOOK_TOKEN}
  # Events on the same source (or source + coalesce_key) arriving within this
  # window merge into a single agent turn.
  coalesce_window_sec: 30.0

memory:
  enabled: true
  recall_enabled: true
  # Defaults to llm.model when omitted. Use an embedding-capable model if your
  # OpenAI-compatible endpoint exposes embeddings separately.
  embedding_model:
  embedding_dimensions: 1536
  max_recalled_memories: 5
  min_relevance_score: 0.25
  # Deduplicate proposed preferences semantically (embedding + LLM tiebreak).
  preference_dedup_enabled: true
  # Cosine >= high -> duplicate outright; in [low, high) -> ask the LLM judge.
  preference_dup_high_threshold: 0.92
  preference_dup_low_threshold: 0.82
  # Cap LLM judge calls per proposal batch / per Find-duplicates run.
  preference_dedup_max_judge_calls: 5
  # Folder of user documents (.md/.txt/.pdf) for `jarvis ingest` and the
  # search_documents agent tool. Leave empty to pass paths explicitly.
  documents_folder:
  document_chunk_chars: 1800
  document_chunk_overlap: 200
  max_document_results: 5

# Dashboard authentication (WebAuthn passkeys + emailed login codes).
# Nothing is enforced while enabled is false.
auth:
  enabled: false
  # Closed allow-list of emails permitted to sign in. No open signup, ever.
  allowed_emails: []
  # Secure, __Host- prefixed session cookie. Requires TLS — set false for
  # local development on plain http://localhost or the cookie will never set.
  secure_cookies: true
  # WebAuthn Relying Party ID: the registrable domain, WITHOUT a port. It
  # must be a DOMAIN — IP addresses are prohibited by the WebAuthn spec, so
  # passkeys will NOT work at http://192.168.x.x:8080; only on the real
  # (reverse-proxied, HTTPS) domain, or on localhost, which is the explicit
  # exception to the HTTPS requirement. Passkeys are BOUND to this rp_id:
  # credentials registered against localhost in development will not work in
  # production and must be re-registered there (and vice versa).
  rp_id: localhost
  rp_name: Jarvis
  # Full browser origin (scheme + host + port) asserted in WebAuthn
  # responses. NOT interchangeable with rp_id: the port is EXCLUDED from
  # rp_id but INCLUDED here — a port mismatch here is the single most common
  # WebAuthn integration error.
  expected_origin: http://localhost:8080
  session_ttl_days: 30
  session_idle_timeout_days: 7
  code_ttl_minutes: 10
  step_up_window_minutes: 5
  # Global cap on outstanding (unconsumed, unexpired) login codes across all
  # users — bounds the standing pool of guessable secrets no matter how the
  # per-address/per-IP request buckets are gamed.
  max_inflight_codes: 20

# Outbound mail for emailed login codes.
#
# ⚠ MAILTRAP IS TWO PRODUCTS — the wrong one fails SILENTLY:
#   - Email SENDING (send.api.mailtrap.io / live.smtp.mailtrap.io) delivers
#     real mail. This is the one production needs.
#   - Email SANDBOX (sandbox.smtp.mailtrap.io) is a fake SMTP server: it
#     CAPTURES mail into a web inbox and NEVER delivers it, while returning
#     success on every send. Production pointed at the sandbox = every login
#     code silently vanishes. Startup refuses that combination.
# The sending domain must be VERIFIED in Mailtrap (from_addr on that domain)
# or nothing sends; an unverified demo domain can only mail the registration
# address — works for one person, breaks silently for the second.
mail:
  # "console" logs codes to the app log (local dev). Use "mailtrap_api" in
  # production (async HTTP; SMTP is the fallback path).
  provider: console
  # api_token: ${JARVIS_MAILTRAP_TOKEN}
  # from_addr: jarvis@your-verified-domain.example
  # SMTP path only — the sandbox flag must agree with the host:
  # smtp_host: live.smtp.mailtrap.io
  # smtp_port: 587
  # sandbox: false
