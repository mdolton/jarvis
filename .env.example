# Jarvis environment variables.
# Copy this to .env and fill in your values.
# docker compose automatically reads .env from the project root.

# === Required ===

# LLM endpoint (LM Studio, Ollama, or any OpenAI-compatible API)
JARVIS_LLM_BASE_URL=http://host.docker.internal:1234/v1
JARVIS_LLM_API_KEY=dummy
JARVIS_LLM_MODEL=qwen2.5:32b

# === Optional ===

# Discord bot token (omit to run without Discord)
# JARVIS_DISCORD_TOKEN=
# JARVIS_DISCORD_ALLOWED_USER_IDS=123456789

# Timezone for schedules (default: UTC)
# JARVIS_TIMEZONE=America/Los_Angeles

# Log level (default: INFO)
# JARVIS_LOG_LEVEL=INFO

# Dashboard port (default: 8080)
# JARVIS_DASHBOARD_PORT=8080

# === OAuth-protected MCP servers (Fastmail / Gmail) ===

# Public base URL Jarvis is reachable at; used to build the OAuth redirect URI
# as <base>/oauth/callback. Use the real https URL in production.
# JARVIS_BASE_URL=https://jarvis.moltonlava.online

# Fernet key encrypting OAuth tokens/secrets at rest. Generate once with:
#   uv run python -c "from jarvis.oauth.crypto import generate_key; print(generate_key())"
# JARVIS_SECRETS_KEY=

# Gmail (manual-mode OAuth) — credentials from a Google Cloud "Web application"
# OAuth client. See the README "OAuth-protected MCP servers" section.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# === Production (docker-compose.prod.yml) ===

# Image tag to run on the server (default: latest). Pin a build for reproducible
# deploys, e.g. the git short SHA printed by `make deploy`.
# JARVIS_IMAGE_TAG=latest
